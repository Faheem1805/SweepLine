{
  "name": "sweepline",
  "private": true,
  "version": "1.0.0",
  "description": "SweepLine — Live Jellyfish Bypass Digital Twin (engineering design visualiser)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "build:map-intro": "tsx scripts/build-map-intro-data.ts",
    "build:tide": "tsx scripts/build-tide-data.ts",
    "study:drift": "tsx scripts/drift-study.ts",
    "build:wildlife": "tsx scripts/build-wildlife-data.ts",
    "study:hindcast": "tsx scripts/hindcast.ts",
    "test": "tsx scripts/test.ts",
    "study": "bash scripts/study-all.sh .study && node scripts/study-collect.mjs .study"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.52.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "html-to-image": "^1.11.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
